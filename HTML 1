<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SHREE JI FAST FOOD - Online Order</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,-apple-system,sans-serif}
body{background:#f8f9fa;color:#333;padding-bottom:30px}
.hero{height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;background:linear-gradient(135deg,#ff5722,#ff9800);padding:20px}
.hero h1{font-size:2.2rem;margin-bottom:8px}
.hero button{margin-top:20px;padding:14px 32px;border:none;border-radius:30px;font-weight:700;background:#fff;color:#e64a19}
#app{display:none;max-width:500px;margin:0 auto;padding:15px}
.header{background:linear-gradient(135deg,#ff5722,#ff9800);color:#fff;padding:22px;border-radius:18px;text-align:center}
.search{width:100%;padding:13px;margin:15px 0;border-radius:12px;border:1px solid #ddd}
.card{background:#fff;margin:10px 0;padding:14px;border-radius:14px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 3px 10px rgba(0,0,0,.06)}
.price{color:#e64a19;font-weight:700}
.btn,.qty button{background:#ff5722;color:#fff;border:none;border-radius:8px;padding:8px 14px}
.qty{display:flex;gap:10px;align-items:center}
.cart{background:#fff;padding:18px;border-radius:16px;margin-top:20px}
.badge{position:fixed;top:15px;right:15px;background:#ff5722;color:#fff;padding:8px 14px;border-radius:30px}
input,textarea{width:100%;padding:12px;margin-top:10px;border:1px solid #ddd;border-radius:10px}
.order,.loc-btn{width:100%;padding:14px;margin-top:10px;border:none;border-radius:10px;color:#fff}
.order{background:#25D366}.loc-btn{background:#ff9800}
</style>
</head>
<body>

<div class="badge">🛒 <span id="count">0</span></div>

<div class="hero" id="welcome">
<div>
<h1>🍔 SHREE JI FAST FOOD</h1>
<p>Fresh Taste • Best Quality • Fast Delivery</p>
<button onclick="startApp()">VIEW MENU & ORDER</button>
</div>
</div>

<div id="app">
<div class="header">
<h2>SHREE JI FAST FOOD</h2>
<p>Direct Delivery On WhatsApp</p>
</div>

<input class="search" id="search" placeholder="Search Menu..." onkeyup="render()">
<div id="menu"></div>

<div class="cart">
<h3>Your Cart</h3>
<div id="cartItems">No items added yet</div>
<h2 id="total">Total: ₹0</h2>

<input id="name" placeholder="Customer Name">
<input id="phone" placeholder="Mobile Number">
<textarea id="address" placeholder="Address"></textarea>

<button class="loc-btn" onclick="fetchLiveLocation()">📍 GPS Location</button>
<small id="loc-status"></small>

<button class="order" onclick="sendOrder()">Order on WhatsApp</button>
</div>
</div>

<script>
const whatsapp="916386476348";

const menuData=[
["Chowmein (Half)",30],["Chowmein (Full)",60],
["Fried Rice (Half)",30],["Fried Rice (Full)",60],
["French Fries (Half)",30],["French Fries (Full)",60],
["Momos (Half)",30],["Momos (Full)",60],
["Spring Roll",25],["Veg Roll",30],
["Burger",30],["Paneer Burger",50],
["Dosa",50],["Masala Dosa",70],["Paneer Dosa",90],
["Pav Bhaji",50],
["Chilli Paneer (Half)",90],["Chilli Paneer (Full)",170],
["Chilli Potato (Half)",70],["Chilli Potato (Full)",130],
["Mix Veg Pizza (Small)",80],["Mix Veg Pizza (Medium)",130],["Mix Veg Pizza (Large)",240],
["Paneer Pizza (Small)",90],["Paneer Pizza (Medium)",160],["Paneer Pizza (Large)",270],
["Onion Paneer Pizza (Small)",90],["Onion Paneer Pizza (Medium)",160],["Onion Paneer Pizza (Large)",270],
["Double Cheese Pizza (Small)",100],["Double Cheese Pizza (Medium)",180],["Double Cheese Pizza (Large)",290],
["Special Pizza (Small)",110],["Special Pizza (Medium)",200],["Special Pizza (Large)",310],
["Sweet Corn Pizza (Small)",90],["Sweet Corn Pizza (Medium)",150],["Sweet Corn Pizza (Large)",260],
["Onion Pizza (Small)",80],["Onion Pizza (Medium)",130],["Onion Pizza (Large)",240],
["Tomato Pizza (Small)",80],["Tomato Pizza (Medium)",130],["Tomato Pizza (Large)",240],
["Capsicum Pizza (Small)",80],["Capsicum Pizza (Medium)",130],["Capsicum Pizza (Large)",240],
["Plain Cheese Pizza (Small)",80],["Plain Cheese Pizza (Medium)",150],["Plain Cheese Pizza (Large)",260],
["Black Olives Pizza (Small)",90],["Black Olives Pizza (Medium)",150],["Black Olives Pizza (Large)",260],
["Red Chilli Pizza (Small)",90],["Red Chilli Pizza (Medium)",150],["Red Chilli Pizza (Large)",260],
["Green Olives Pizza (Small)",90],["Green Olives Pizza (Medium)",150],["Green Olives Pizza (Large)",260],
["Pizza Patties",70],["Pizza Paneer Patties",80],["Pizza Patties Special",100],
["Plain Burger",50],["Paneer Burger Special",60],["Double Cheese Burger",80]
];

let cart=[],googleMapsUrl="";

function startApp(){welcome.style.display='none';app.style.display='block';render();}
function qty(n){return cart.find(x=>x.name===n)?.qty||0;}
function add(n,p){let i=cart.find(x=>x.name===n);i?i.qty++:cart.push({name:n,price:p,qty:1});update();}
function change(n,v){let i=cart.find(x=>x.name===n);if(!i)return;i.qty+=v;if(i.qty<=0)cart=cart.filter(x=>x.name!==n);update();}

function render(){
let q=(search.value||"").toLowerCase();
menu.innerHTML="";
menuData.filter(i=>i[0].toLowerCase().includes(q)).forEach(i=>{
let c=qty(i[0]);
menu.innerHTML+=`<div class="card"><div><b>${i[0]}</b><div class="price">₹${i[1]}</div></div><div>${c?`<div class="qty"><button onclick="change('${i[0]}',-1)">-</button>${c}<button onclick="change('${i[0]}',1)">+</button></div>`:`<button class="btn" onclick="add('${i[0]}',${i[1]})">Add</button>`}</div></div>`;
});
}

function update(){
let total=0,count=0,h="";
cart.forEach(i=>{let s=i.qty*i.price;total+=s;count+=i.qty;h+=`${i.name} x ${i.qty} = ₹${s}<br>`;});
cartItems.innerHTML=h||"No items added yet";
document.getElementById('total').innerText="Total: ₹"+total;
countEl=document.getElementById('count');countEl.innerText=count;
}
function fetchLiveLocation(){document.getElementById('loc-status').innerText="Location feature ready";}
function sendOrder(){alert("WhatsApp order ready");}
</script>
</body>
</html>
